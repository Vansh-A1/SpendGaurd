# SpendGuard Configuration & Environment Variables

# Application
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-32-character-random-secret-key

# Razorpay Test Rail Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Demo & Role Accounts (Leave blank to auto-generate random passwords on initial boot)
ADMIN_EMAIL=admin@spendguard.ai
ADMIN_PASSWORD=
OPERATOR_EMAIL=operator@spendguard.ai
OPERATOR_PASSWORD=
VIEWER_EMAIL=viewer@spendguard.ai
VIEWER_PASSWORD=

# Live Agent Simulation & LLM Budget Guard
LLM_PROVIDER=fallback       # Options: openai | anthropic | gemini | ollama | fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Safety Limits
MAX_SIMULATION_RUNS_PER_BATCH=20
MAX_LLM_CALLS_PER_DAY=100
